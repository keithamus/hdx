{
	"name": "csskit",
	"displayName": "csskit",
	"version": "1.0.9",
	"description": "Refreshing CSS",
	"keywords": [],
	"repository": "https://github.com/csskit/csskit",
	"funding": {
		"url": "https://github.com/sponsors/keithamus"
	},
	"publisher": "csskit",
	"icon": "icon.png",
	"license": "MIT",
	"author": "Keith Cirkel (https://keithcirkel.co.uk)",
	"type": "commonjs",
	"main": "./dist/main.js",
	"scripts": {
		"build": "esbuild src/main.js --bundle --outfile=dist/main.js --format=cjs --platform=node --external:vscode --minify",
		"check": "prettier --check . && npm run lint && npm run typecheck",
		"fmt": "prettier --write .",
		"lint": "oxlint",
		"typecheck": "tsc",
		"vscode:prepublish": "npm run build",
		"watch": "npm run build -- --watch",
		"watch-test": "vscode-test"
	},
	"contributes": {
		"commands": [
			{
				"command": "extension.helloWorld",
				"title": "Hello World"
			}
		],
		"configuration": [],
		"configurationDefaults": {},
		"keybindings": [],
		"problemMatchers": [],
		"problemPatterns": [],
		"semanticTokenModifiers": [],
		"semanticTokenScopes": [
			{
				"scopes": {
					"Tag": [
						"entity.name.tag.css"
					],
					"Tag.Unknown": [
						"invalid",
						"meta.selector.css"
					],
					"Tag.Experimental": [
						"entity.name.tag.css"
					],
					"Tag.Deprecated": [
						"invalid.deprecated",
						"entity.name.tag.css"
					],
					"Tag.Vendor": [
						"invalid.deprecated",
						"entity.name.tag.css"
					],
					"Declaration": [
						"support.type.property-name.css"
					],
					"Declaration.Unknown": [
						"invalid",
						"meta.property-name.css"
					],
					"Declaration.Deprecated": [
						"invalid.deprecated",
						"meta.property-name.css"
					],
					"Declaration.Vendor": [
						"invalid.deprecated",
						"meta.property-name.css"
					],
					"Declaration.Custom": [
						"variable.css",
						"meta.property-list.css"
					],
					"PseudoClass": [
						"entity.other.attribute-name.pseudo-class.css"
					],
					"PseudoElement": [
						"entity.other.attribute-name.pseudo-element.css"
					],
					"PseudoClass.Vendor": [
						"invalid.deprecated",
						"entity.other.attribute-name.pseudo-class.css"
					],
					"PseudoElement.Vendor": [
						"invalid.deprecated",
						"entity.other.attribute-name.pseudo-element.css"
					],
					"Id": [
						"entity.other.attribute-name.id"
					],
					"Punctuation": [
						"punctuation.section",
						"source.css"
					]
				}
			}
		],
		"semanticTokenTypes": [],
		"snippets": [],
		"taskDefinitions": [],
		"views": [],
		"walkthroughs": []
	},
	"activationEvents": [
		"onLanguage:css"
	],
	"dependencies": {
		"vscode-languageclient": "10.0.1"
	},
	"devDependencies": {
		"@types/mocha": "10.0.10",
		"@types/node": "24.19.2",
		"@types/vscode": "1.140.0",
		"@vscode/test-cli": "0.0.15",
		"@vscode/test-electron": "3.1.0",
		"esbuild": "0.28.2",
		"mocha": "12.0.3",
		"oxlint": "1.82.0",
		"prettier": "3.9.10",
		"tinyglobby": "0.2.17",
		"typescript": "7.0.2"
	},
	"engines": {
		"vscode": "^1.120.0"
	},
	"prettierConfig": {
		"useTabs": true,
		"printWidth": 120
	}
}
