{
	"name": "csskit-website",
	"version": "0.0.0-development",
	"private": true,
	"type": "module",
	"scripts": {
		"prebuild": "mise run build-csskit-wasm",
		"build": "eleventy",
		"postbuild": "npm run clean-old",
		"prebuild:dev": "mise run build-csskit-wasm",
		"build:dev": "eleventy",
		"postbuild:dev": "npm run clean-old",
		"clean-old": "ls -t playground/ | grep csskit | tail -n +2 | xargs rm -f",
		"postinstall": "[ \"$NODE_ENV\" = \"production\" ] && npm run build || npm run build:dev",
		"prestart": "npm run postinstall",
		"start": "eleventy --serve"
	},
	"dependencies": {
		"@codemirror/lang-css": "6.3.1",
		"@codemirror/lang-json": "6.0.2",
		"@codemirror/lang-rust": "6.0.2",
		"@codemirror/lang-sass": "6.0.2",
		"@codemirror/language": "6.11.3",
		"@codemirror/lint": "6.8.5",
		"@codemirror/state": "6.5.4",
		"@codemirror/view": "6.38.8",
		"@mdit/plugin-alert": "^2.0.0",
		"apexcharts": "^7.0.0",
		"codemirror": "6.0.2",
		"csskit": "../packages/csskit/",
		"markdown-it-anchor": "^9.2.0",
		"openswatch": "^0.1.0"
	},
	"devDependencies": {
		"@11ty/eleventy": "3.1.6",
		"@11ty/eleventy-plugin-rss": "3.1.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
		"@manustays/eleventy-plugin-generate-social-images": "4.1.0",
		"cssnano": "9.6.0",
		"esbuild": "0.28.2",
		"esbuild-plugin-wasm": "1.1.0",
		"glob": "13.0.6",
		"html-minifier": "4.0.0",
		"open-props": "1.7.23",
		"postcss-import": "17.0.0",
		"postcss-jit-props": "1.0.16",
		"postcss-preset-env": "11.4.0",
		"sharp": "0.35.5"
	}
}
